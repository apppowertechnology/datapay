      "destination": "/about.html"
    },
    {
      "source": "/services",
      "destination": "/services.html"
    },
    {
      "source": "/event-ticketing",
      "destination": "/event-ticketing.html"
    },
    {
      "source": "/data-airtime",
      "destination": "/data-airtime.html"
    },
    {
